<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LearnSomething.Client.ViewModels"
        xmlns:loc="using:LearnSomething.Client.Localization"
        xmlns:acv="using:Avalonia.Data.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="LearnSomething.Client.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Icon="/Assets/learnsomething-icon.ico"
        Title="{Binding Path=SettingsWindowTitle, Source={x:Static loc:Strings.Instance}}"
        Width="740" Height="680"
        MinWidth="580" MinHeight="480"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Helvetica Neue,Segoe UI,Inter">

    <Window.Resources>
        <DataTemplate x:Key="WordRowTemplate" x:DataType="vm:WordRowViewModel">
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,8" VerticalAlignment="Center">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Term}" FontWeight="Medium" />
                    <TextBlock Text="{Binding Translation}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                </StackPanel>
                <Button Grid.Column="1" Content="{Binding Path=EditButton, Source={x:Static loc:Strings.Instance}}" Classes="link" Command="{Binding EditCommand}" />
                <Button Grid.Column="2" Content="{Binding Path=DeleteButton, Source={x:Static loc:Strings.Instance}}" Classes="danger" Command="{Binding DeleteCommand}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <TabControl Margin="24">

        <TabItem Header="{Binding Path=TabHome, Source={x:Static loc:Strings.Instance}}">
            <StackPanel Spacing="14" Margin="0,24,0,0" MaxWidth="480" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Path=HomeTitle, Source={x:Static loc:Strings.Instance}}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding Path=HomeDescription, Source={x:Static loc:Strings.Instance}}"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="14" TextWrapping="Wrap" />

                <StackPanel Spacing="4" Margin="0,18,0,0">
                    <TextBlock Text="{Binding Path=ContactHeading, Source={x:Static loc:Strings.Instance}}"
                               FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Path=ContactEmail, Source={x:Static loc:Strings.Instance}}"
                               FontSize="13" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </StackPanel>
        </TabItem>

        <TabItem Header="{Binding Path=TabLists, Source={x:Static loc:Strings.Instance}}">
            <Grid Margin="0,20,0,0">

                <!-- List picker -->
                <StackPanel Spacing="14" IsVisible="{Binding OpenList, Converter={x:Static acv:ObjectConverters.IsNull}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Width="240" PlaceholderText="{Binding Path=NewListNamePlaceholder, Source={x:Static loc:Strings.Instance}}" Text="{Binding NewListName}" />
                        <Button Content="{Binding Path=CreateListButton, Source={x:Static loc:Strings.Instance}}" Classes="secondary" Command="{Binding CreateListCommand}" />
                    </StackPanel>

                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Lists}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:WordListRowViewModel">
                                    <Border Classes.active="{Binding IsActive}"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderThickness="1.5"
                                            BorderBrush="Transparent"
                                            CornerRadius="12"
                                            Padding="16,12"
                                            Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="15" />
                                                    <TextBlock Text="{Binding Path=CurrentlyStudyingBadge, Source={x:Static loc:Strings.Instance}}" Foreground="{StaticResource PrimaryBrush}"
                                                               FontWeight="Medium" FontSize="12" VerticalAlignment="Center"
                                                               IsVisible="{Binding IsActive}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding WordCountLabel}"
                                                           Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{Binding Path=OpenButton, Source={x:Static loc:Strings.Instance}}" Classes="secondary" Margin="4,0" Command="{Binding OpenCommand}" />
                                            <Button Grid.Column="2" Content="{Binding Path=DeleteButton, Source={x:Static loc:Strings.Instance}}" Classes="danger" Margin="4,0" Command="{Binding DeleteCommand}"
                                                    Padding="22,10" FontSize="14" FontWeight="Medium" CornerRadius="22" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- List detail: word management scoped to the opened list -->
                <Grid IsVisible="{Binding OpenList, Converter={x:Static acv:ObjectConverters.IsNotNull}}"
                      RowDefinitions="Auto,*">

                    <StackPanel Grid.Row="0" Spacing="18" Margin="0,0,0,16">
                        <Button Content="{Binding Path=BackButton, Source={x:Static loc:Strings.Instance}}" Classes="secondary" Padding="14,6" FontSize="13"
                                HorizontalAlignment="Left" Command="{Binding CloseListCommand}" />
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding OpenList.Name}" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding Path=CurrentlyStudyingBadge, Source={x:Static loc:Strings.Instance}}" Foreground="{StaticResource PrimaryBrush}"
                                       FontWeight="Medium" FontSize="12"
                                       IsVisible="{Binding OpenList.IsActive}" />
                        </StackPanel>
                    </StackPanel>

                    <TabControl Grid.Row="1">

                        <TabItem Header="{Binding Path=TabStartStudying, Source={x:Static loc:Strings.Instance}}">
                            <ScrollViewer>
                                <StackPanel Spacing="18" Margin="0,20,0,0">
                                    <CheckBox Content="{Binding Path=ShowMeaningFirstLabel, Source={x:Static loc:Strings.Instance}}"
                                              IsChecked="{Binding ListShowMeaningFirst}" />

                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding Path=StudyModeLabel, Source={x:Static loc:Strings.Instance}}" />
                                        <ComboBox SelectedIndex="{Binding ListStudyModeIndex}" Width="230" HorizontalAlignment="Left">
                                            <ComboBoxItem Content="{Binding Path=StudyModeNewAndReview, Source={x:Static loc:Strings.Instance}}" />
                                            <ComboBoxItem Content="{Binding Path=StudyModeNewOnly, Source={x:Static loc:Strings.Instance}}" />
                                            <ComboBoxItem Content="{Binding Path=StudyModeReviewOnly, Source={x:Static loc:Strings.Instance}}" />
                                            <ComboBoxItem Content="{Binding Path=StudyModeLearnedOnly, Source={x:Static loc:Strings.Instance}}" />
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Last, so it reads as "settings are done, now you can start". -->
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Button Content="{Binding OpenList.StartStudyingLabel}"
                                                    Classes="primary"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding OpenList.StartStudyingCommand}" />
                                            <Button Content="{Binding Path=RestartButton, Source={x:Static loc:Strings.Instance}}" Classes="secondary"
                                                    Command="{Binding OpenList.RestartCommand}"
                                                    IsVisible="{Binding OpenList.IsInPlay}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Path=RestartExplanation, Source={x:Static loc:Strings.Instance}}"
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                                   IsVisible="{Binding OpenList.IsInPlay}" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="{Binding Path=TabAddEditWords, Source={x:Static loc:Strings.Instance}}">
                            <ScrollViewer Padding="0,0,16,0">
                                <StackPanel Spacing="18" Margin="0,20,0,0">
                                    <Grid ColumnDefinitions="Auto,Auto,Auto" HorizontalAlignment="Left">
                                        <Button Grid.Column="0" Content="{Binding Path=AddWordButton, Source={x:Static loc:Strings.Instance}}" Classes="secondary"
                                                Command="{Binding StartAddingWordCommand}" VerticalAlignment="Top" Margin="0,0,16,0" />

                                        <Border Grid.Column="1" Width="1" Background="{StaticResource DividerBrush}" Margin="0,2,16,2" />

                                        <StackPanel Grid.Column="2" Spacing="6">
                                            <Button Content="{Binding Path=ImportCsvButton, Source={x:Static loc:Strings.Instance}}" Classes="secondary" Click="OnImportClick"
                                                    ToolTip.Tip="{Binding Path=ImportCsvTooltip, Source={x:Static loc:Strings.Instance}}" HorizontalAlignment="Left" />
                                            <CheckBox Content="{Binding Path=CsvHasHeaderRowLabel, Source={x:Static loc:Strings.Instance}}"
                                                      IsChecked="{Binding CsvHasHeaderRow}" FontSize="11" Padding="4,0" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{Binding Path=WordsHeading, Source={x:Static loc:Strings.Instance}}" FontWeight="SemiBold" FontSize="18" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,0" />

                                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource PrimaryBrush}" IsVisible="{Binding HasStatusMessage}" />

                                    <!-- Collapsed by default; opens for add or edit, closes again after.
                                         Capped width so text inputs don't stretch absurdly wide — the word
                                         rows below are what should actually use the full expanded area. -->
                                    <Border IsVisible="{Binding IsWordFormVisible}"
                                            Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="16"
                                            MaxWidth="480" HorizontalAlignment="Left">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="{Binding FormTitle}" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBox PlaceholderText="{Binding Path=TermPlaceholder, Source={x:Static loc:Strings.Instance}}" Text="{Binding NewTerm}" />
                                            <TextBox PlaceholderText="{Binding Path=TranslationPlaceholder, Source={x:Static loc:Strings.Instance}}" Text="{Binding NewTranslation}" />
                                            <TextBox PlaceholderText="{Binding Path=ExamplePlaceholder, Source={x:Static loc:Strings.Instance}}" Text="{Binding NewExample}" />
                                            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsEditingWord}">
                                                <TextBlock Text="{Binding Path=StatusLabel, Source={x:Static loc:Strings.Instance}}" VerticalAlignment="Center" />
                                                <ComboBox SelectedIndex="{Binding NewStatusIndex}" Width="170">
                                                    <ComboBoxItem Content="{Binding Path=StatusNew, Source={x:Static loc:Strings.Instance}}" />
                                                    <ComboBoxItem Content="{Binding Path=StatusLearned, Source={x:Static loc:Strings.Instance}}" />
                                                    <ComboBoxItem Content="{Binding Path=StatusToRepeat, Source={x:Static loc:Strings.Instance}}" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                                <Button Content="{Binding SaveButtonText}" Classes="primary" Command="{Binding SaveWordCommand}" />
                                                <Button Content="{Binding Path=CancelButton, Source={x:Static loc:Strings.Instance}}" Classes="link" Command="{Binding CancelEditCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <ComboBox SelectedIndex="{Binding WordFilterIndex}" Width="200" VerticalAlignment="Center">
                                            <ComboBoxItem Content="{Binding Path=FilterAll, Source={x:Static loc:Strings.Instance}}" />
                                            <ComboBoxItem Content="{Binding Path=FilterNew, Source={x:Static loc:Strings.Instance}}" />
                                            <ComboBoxItem Content="{Binding Path=FilterToRepeat, Source={x:Static loc:Strings.Instance}}" />
                                            <ComboBoxItem Content="{Binding Path=FilterLearned, Source={x:Static loc:Strings.Instance}}" />
                                        </ComboBox>
                                        <Button Content="{Binding Path=RefreshButton, Source={x:Static loc:Strings.Instance}}" Classes="secondary"
                                                Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Grouped by default ("Tüm kelimeler"); the filter above can
                                         narrow this down to just one section at a time. -->
                                    <StackPanel Spacing="8" IsVisible="{Binding ShowNewWordsSection}">
                                        <TextBlock Text="{Binding NewWordsHeading}"
                                                   FontWeight="Medium" FontSize="13" Foreground="{StaticResource TextMutedBrush}" />
                                        <ItemsControl ItemsSource="{Binding NewWords}" ItemTemplate="{StaticResource WordRowTemplate}" />
                                    </StackPanel>

                                    <StackPanel Spacing="8" IsVisible="{Binding ShowToRepeatSection}">
                                        <TextBlock Text="{Binding ToRepeatHeading}"
                                                   FontWeight="Medium" FontSize="13" Foreground="{StaticResource TextMutedBrush}" />
                                        <ItemsControl ItemsSource="{Binding ToRepeatWords}" ItemTemplate="{StaticResource WordRowTemplate}" />
                                    </StackPanel>

                                    <StackPanel Spacing="8" IsVisible="{Binding ShowLearnedSection}">
                                        <TextBlock Text="{Binding LearnedHeading}"
                                                   FontWeight="Medium" FontSize="13" Foreground="{StaticResource TextMutedBrush}" />
                                        <ItemsControl ItemsSource="{Binding LearnedWords}" ItemTemplate="{StaticResource WordRowTemplate}" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                    </TabControl>
                </Grid>
            </Grid>
        </TabItem>

        <TabItem Header="{Binding Path=TabSettings, Source={x:Static loc:Strings.Instance}}">
            <StackPanel Spacing="28" Margin="0,24,0,0" MaxWidth="480" HorizontalAlignment="Left">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding Path=DailyGoalHeading, Source={x:Static loc:Strings.Instance}}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding Path=DailyWordCountLabel, Source={x:Static loc:Strings.Instance}}" VerticalAlignment="Center" />
                        <TextBox Width="70" Text="{Binding DailyWordCount}" />
                    </StackPanel>
                    <CheckBox Content="{Binding Path=StudyAllListsLabel, Source={x:Static loc:Strings.Instance}}"
                              IsChecked="{Binding StudyAllLists}" />
                    <TextBlock Text="{Binding Path=StudyAllListsExplanation, Source={x:Static loc:Strings.Instance}}"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" MaxWidth="420" />
                    <CheckBox Content="{Binding Path=CloseCardWhenQuotaReachedLabel, Source={x:Static loc:Strings.Instance}}"
                              IsChecked="{Binding CloseCardWhenQuotaReached}" />
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding Path=SystemHeading, Source={x:Static loc:Strings.Instance}}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <CheckBox Content="{Binding Path=StartOnBootLabel, Source={x:Static loc:Strings.Instance}}"
                              IsChecked="{Binding StartOnBoot}" />
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding Path=LanguageHeading, Source={x:Static loc:Strings.Instance}}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <ComboBox SelectedIndex="{Binding LanguageIndex}" Width="200" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Türkçe" />
                        <ComboBoxItem Content="English" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding Path=CardHeading, Source={x:Static loc:Strings.Instance}}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <Button Content="{Binding Path=ResetCardBoundsButton, Source={x:Static loc:Strings.Instance}}" Classes="secondary" HorizontalAlignment="Left" Command="{Binding ResetCardBoundsCommand}" />
                    <TextBlock Text="{Binding Path=ResetCardBoundsExplanation, Source={x:Static loc:Strings.Instance}}"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" MaxWidth="400" />
                </StackPanel>

                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource PrimaryBrush}" IsVisible="{Binding HasStatusMessage}" />
            </StackPanel>
        </TabItem>

    </TabControl>
</Window>
