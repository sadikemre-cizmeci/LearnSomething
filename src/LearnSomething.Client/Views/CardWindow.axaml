<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LearnSomething.Client.ViewModels"
        xmlns:loc="using:LearnSomething.Client.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="LearnSomething.Client.Views.CardWindow"
        x:DataType="vm:CardViewModel"
        Icon="/Assets/learnsomething-icon.ico"
        Title="LearnSomething"
        WindowDecorations="BorderOnly"
        CanResize="True"
        ShowInTaskbar="False"
        Width="380" Height="330"
        MinWidth="280" MinHeight="220"
        Background="{StaticResource DeskBackgroundBrush}"
        FontFamily="Helvetica Neue,Segoe UI,Inter">

    <!-- The window is the "desk"; this Border is the physical index card sitting on it. -->
    <Border Background="{StaticResource CardPaperBrush}"
            CornerRadius="14"
            Margin="10"
            ClipToBounds="True"
            BoxShadow="0 6 18 -4 #40000000">
        <Grid>

            <!-- Ruled lines, like a paper index card. Purely decorative. -->
            <Grid Margin="0,56,0,10" IsHitTestVisible="False" RowDefinitions="*,*,*,*,*,*,*,*,*,*">
                <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{StaticResource RuleLineBrush}" />
                <Border Grid.Row="1" BorderThickness="0,0,0,1" BorderBrush="{StaticResource RuleLineBrush}" />
                <Border Grid.Row="2" BorderThickness="0,0,0,1" BorderBrush="{StaticResource RuleLineBrush}" />
                <Border Grid.Row="3" BorderThickness="0,0,0,1" BorderBrush="{StaticResource RuleLineBrush}" />
                <Border Grid.Row="4" BorderThickness="0,0,0,1" BorderBrush="{StaticResource RuleLineBrush}" />
                <Border Grid.Row="5" BorderThickness="0,0,0,1" BorderBrush="{StaticResource RuleLineBrush}" />
                <Border Grid.Row="6" BorderThickness="0,0,0,1" BorderBrush="{StaticResource RuleLineBrush}" />
                <Border Grid.Row="7" BorderThickness="0,0,0,1" BorderBrush="{StaticResource RuleLineBrush}" />
                <Border Grid.Row="8" BorderThickness="0,0,0,1" BorderBrush="{StaticResource RuleLineBrush}" />
                <Border Grid.Row="9" BorderThickness="0,0,0,1" BorderBrush="{StaticResource RuleLineBrush}" />
            </Grid>

            <!-- Left margin stripe, like a ruled notebook card. -->
            <Rectangle Width="3"
                       HorizontalAlignment="Left"
                       Margin="12,16,0,16"
                       RadiusX="1.5" RadiusY="1.5"
                       Fill="{StaticResource PrimaryBrush}"
                       Opacity="0.55"
                       IsHitTestVisible="False" />

            <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="26,14,18,14">

                <!-- Header: close button, always reachable. Rest of the row is the drag handle. -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" PointerPressed="OnDragAreaPointerPressed">
                    <Button Grid.Column="1"
                            Classes="icon"
                            Command="{Binding CloseCommand}"
                            ToolTip.Tip="{Binding Path=CardCloseTooltip, Source={x:Static loc:Strings.Instance}}">
                        <TextBlock Text="&#10005;&#65038;" FontFamily="Inter" FontSize="17" LineHeight="17" Foreground="{StaticResource TextMutedBrush}" />
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" Spacing="14" Margin="4,0">

                        <!-- Normal card: front (key), then after reveal, back (value) + example -->
                        <StackPanel IsVisible="{Binding HasCurrentWord}" Spacing="14" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding FrontText}"
                                       FontSize="25"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />

                            <Button Content="{Binding Path=CardReveal, Source={x:Static loc:Strings.Instance}}"
                                    Classes="secondary"
                                    Command="{Binding RevealCommand}"
                                    IsVisible="{Binding !IsRevealed}"
                                    HorizontalAlignment="Center" />

                            <StackPanel IsVisible="{Binding IsRevealed}" Spacing="8" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding BackText}"
                                           FontSize="18"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           FontWeight="Medium"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ExampleText}"
                                           IsVisible="{Binding HasExample}"
                                           FontStyle="Italic"
                                           FontSize="13"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="280" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Daily quota reached: styled like the word front-text so it reads as "the next thing on the card" -->
                        <StackPanel IsVisible="{Binding IsQuotaReached}" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Path=CardGoalReached, Source={x:Static loc:Strings.Instance}}"
                                       FontSize="25"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Genuinely nothing left for this mode — stronger than the daily quota
                             message above; lists which list(s)/mode(s) are done, one per line. -->
                        <StackPanel IsVisible="{Binding IsAllFinished}" Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Path=CardAllFinishedHeading, Source={x:Static loc:Strings.Instance}}"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding AllFinishedMessage}"
                                       FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="280" />
                        </StackPanel>

                        <!-- No active list chosen yet -->
                        <StackPanel IsVisible="{Binding HasNoActiveList}" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Path=CardNoListChosen, Source={x:Static loc:Strings.Instance}}"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="240" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- Unified action row: whichever set applies to the current state. Same slot every time.
                     WrapPanel so it never crowds/overflows — buttons drop to a second line if the
                     card is narrow instead of getting squeezed or clipped. -->
                <WrapPanel Grid.Row="2"
                           HorizontalAlignment="Center"
                           Margin="0,14,0,0"
                           ItemSpacing="10"
                           LineSpacing="8">
                    <Button Content="{Binding Path=CardLearned, Source={x:Static loc:Strings.Instance}}" Classes="primary" Command="{Binding LearnedCommand}" IsVisible="{Binding IsRevealed}" />
                    <Button Content="{Binding Path=CardRepeat, Source={x:Static loc:Strings.Instance}}" Classes="secondary" Command="{Binding RepeatCommand}" IsVisible="{Binding IsRevealed}" />
                    <Button Content="{Binding Path=CardContinue, Source={x:Static loc:Strings.Instance}}" Classes="primary" Command="{Binding ContinueBeyondQuotaCommand}" IsVisible="{Binding IsQuotaReached}" />
                    <Button Content="{Binding Path=CardOpenSettings, Source={x:Static loc:Strings.Instance}}" Classes="primary" Command="{Binding OpenSettingsCommand}" IsVisible="{Binding HasNoActiveList}" />
                    <Button Content="{Binding Path=CardOpenSettings, Source={x:Static loc:Strings.Instance}}" Classes="primary" Command="{Binding OpenSettingsCommand}" IsVisible="{Binding IsAllFinished}" />
                </WrapPanel>

                <!-- Settings, bottom-right, always reachable. -->
                <Button Grid.Row="3"
                        Classes="icon"
                        Command="{Binding OpenSettingsCommand}"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0"
                        ToolTip.Tip="{Binding Path=CardSettingsTooltip, Source={x:Static loc:Strings.Instance}}">
                    <TextBlock Text="&#9881;&#65038;" FontFamily="Inter" FontSize="19" LineHeight="19" Foreground="{StaticResource TextMutedBrush}" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
