<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnSomething.Client.App"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FBF6EF" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#5B8C72" />
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#4A7360" />
        <SolidColorBrush x:Key="PrimarySoftBrush" Color="#E4EEE8" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#2E2A24" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#8C8478" />
        <SolidColorBrush x:Key="DividerBrush" Color="#E8E0D4" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B5675A" />
        <SolidColorBrush x:Key="DangerSoftBrush" Color="#F3E4E1" />

        <!-- Card-as-paper palette: a "desk" backdrop the card visually sits on top of. -->
        <SolidColorBrush x:Key="DeskBackgroundBrush" Color="#E7E1D4" />
        <SolidColorBrush x:Key="CardPaperBrush" Color="#FFFCF6" />
        <SolidColorBrush x:Key="RuleLineBrush" Color="#E4E8F0" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="22,11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1.3" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="22,10" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="21" />
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
        </Style>

        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="ComboBoxItem">
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Explicit FontSize on both states so the selected tab doesn't visually
             jump in size the way FluentTheme's default selected-state style does. -->
        <Style Selector="TabItem">
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="FontSize" Value="15" />
        </Style>

        <!-- Marks the currently-active word list's row in the Listeler tab. -->
        <Style Selector="Border.active">
            <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
        </Style>
    </Application.Styles>
</Application>
